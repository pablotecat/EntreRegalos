generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// Enums
// ─────────────────────────────────────────

enum Role {
  ADMIN
  USER
}

enum Visibility {
  PUBLIC
  PRIVATE
}

// ─────────────────────────────────────────
// Modelos
// ─────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  role         Role     @default(USER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  lists         List[]
  refreshTokens       RefreshToken[]
  createdInvitations  Invitation[] @relation("createdInvitations")
  passwordResetTokens PasswordResetToken[]

  invitationTokenId String?     @unique
  invitationToken   Invitation? @relation("registeredInvitation", fields: [invitationTokenId], references: [id])

  @@map("users")
}

model Invitation {
  id          String   @id @default(uuid())
  token       String   @unique @default(uuid())
  reference   String?
  used        Boolean  @default(false)
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  createdById String
  createdBy   User     @relation("createdInvitations", fields: [createdById], references: [id])

  registeredUser User? @relation("registeredInvitation")

  @@index([token])
  @@map("invitations")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  revoked   Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("refresh_tokens")
}

model List {
  id         String     @id @default(uuid())
  name       String
  visibility Visibility @default(PRIVATE)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])

  items Item[]

  @@index([ownerId])
  @@index([visibility])
  @@map("lists")
}

model Item {
  id          String   @id @default(uuid())
  name        String
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  listId String
  list   List   @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@index([listId])
  @@map("items")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique @default(uuid())
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("password_reset_tokens")
}